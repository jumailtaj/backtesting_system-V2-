# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# API key and secret come from your app page at https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# The access token is regenerated every trading day (see README, "Daily login").
# The CLI can write it here for you after you paste the request_token.
KITE_ACCESS_TOKEN=
